{
  "name": "voto.io",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Damiano Barbati <damiano.barbati@gmail.com> (https://github.com/damianobarbati)",
  "repository": "https://github.com/damianobarbati/voto.io",
  "description": "Poll and vote.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "pnpm": ">=12.3",
    "node": ">=26.7"
  },
  "type": "module",
  "scripts": {
    "//postinstall": "pnpm audit --audit-level critical",
    "lint": "biome check --write",
    "tsc": "tsc",
    "env:up": "docker compose up -d --wait --quiet-pull --remove-orphans",
    "env:down": "docker compose down --volumes --remove-orphans"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
